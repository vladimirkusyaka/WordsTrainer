@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@using WordsTrainer.Contracts.Auth
@using WordsTrainer.Web.Services
@inject PasswordResetApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Create New Password</PageTitle>

<style>
    .reset-shell {
        min-height: 100vh;
        background: #f5f7fa;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .reset-card-wrap {
        width: 100%;
        max-width: 460px;
    }

    .reset-brand,
    .reset-success {
        text-align: center;
        margin-bottom: 24px;
    }

    .reset-brand-icon,
    .reset-success-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        border-radius: 18px;
        background: #eaf0ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .reset-success-icon {
        width: 80px;
        height: 80px;
        border-radius: 40px;
        background: #eaf9f0;
        font-size: 36px;
    }

    .reset-brand h1,
    .reset-success h1 {
        font-size: 50px;
        font-weight: 700;
        color: #1b1e32;
        margin: 0 0 8px 0;
    }

    .reset-brand p,
    .reset-success p {
        color: #6f7789;
        font-size: 14px;
        line-height: 1.5;
        margin: 0;
    }

    .reset-card {
        background: #ffffff;
        border: 1px solid #e1e6ef;
        border-radius: 26px;
        padding: 24px;
        box-shadow: 0 10px 26px rgba(20, 31, 61, 0.06);
    }

    .reset-field {
        margin-bottom: 16px;
    }

    .reset-field label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #1b1e32;
    }

    .reset-input-wrap {
        position: relative;
    }

    .reset-input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #8792a8;
        font-size: 16px;
    }

    .reset-eye-btn {
        border: 0;
        background: transparent;
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #8792a8;
        font-size: 16px;
        line-height: 1;
    }

    .reset-input {
        width: 100%;
        height: 56px;
        border-radius: 18px;
        border: 1px solid #dde3ef;
        background: #f9fbff;
        padding: 0 44px 0 46px;
        font-size: 15px;
        color: #1b1e32;
    }

    .reset-input:focus {
        outline: 0;
        border-color: #4a6cf7;
        box-shadow: 0 0 0 3px rgba(74, 108, 247, 0.15);
    }

    .reset-rules {
        margin: 6px 0 14px;
    }

    .reset-rule-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #7a8296;
        margin-bottom: 6px;
    }

    .reset-rule-dot {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #e5e9f2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        color: #ffffff;
    }

    .reset-rule-dot.ok {
        background: #33b26f;
    }

    .ok-text {
        color: #23995a;
    }

    .reset-alert {
        border-radius: 14px;
        padding: 12px 14px;
        font-size: 14px;
        margin-bottom: 12px;
    }

    .reset-alert-error {
        background: #fff1f1;
        color: #ce3a3a;
        border: 1px solid #ffd3d3;
    }

    .reset-submit {
        width: 100%;
        height: 56px;
        border-radius: 18px;
        border: 0;
        background: #3367e8;
        color: #ffffff;
        font-size: 16px;
        font-weight: 600;
        margin-top: 6px;
    }

    .reset-submit:disabled {
        opacity: 0.6;
    }

    .reset-footer {
        text-align: center;
        font-size: 12px;
        color: #8a92a6;
        margin-top: 16px;
    }

    .reset-validation {
        color: #ce3a3a;
        font-size: 13px;
        margin: 8px 0 10px;
    }
</style>

<main class="reset-shell">
    <section class="reset-card-wrap">
        <div class="reset-brand">
            <div class="reset-brand-icon">🔒</div>
            <h1>Create new password</h1>
            <p>Your new password must be different from previously used passwords.</p>
        </div>

        @if (string.IsNullOrWhiteSpace(Token))
        {
            <div class="reset-alert reset-alert-error">
                Password reset token is missing or invalid.
            </div>
        }
        else
        {
            <div class="reset-card">
                <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="reset-field">
                        <label for="password">New Password</label>
                        <div class="reset-input-wrap">
                            <span class="reset-input-icon">🔒</span>
                            <InputText id="password"
                                       type="@(_showPassword ? "text" : "password")"
                                       class="reset-input"
                                       @bind-Value="_model.Password"
                                       @oninput="OnPasswordChanged"
                                       placeholder="Enter new password" />
                            <button type="button" class="reset-eye-btn" @onclick="TogglePasswordVisibility">
                                @(_showPassword ? "🙈" : "👁")
                            </button>
                        </div>
                    </div>

                    <div class="reset-field">
                        <label for="confirmPassword">Confirm Password</label>
                        <div class="reset-input-wrap">
                            <span class="reset-input-icon">🔒</span>
                            <InputText id="confirmPassword"
                                       type="@(_showConfirmPassword ? "text" : "password")"
                                       class="reset-input"
                                       @bind-Value="_model.ConfirmPassword"
                                       @oninput="OnPasswordChanged"
                                       placeholder="Confirm new password" />
                            <button type="button" class="reset-eye-btn" @onclick="ToggleConfirmPasswordVisibility">
                                @(_showConfirmPassword ? "🙈" : "👁")
                            </button>
                        </div>
                    </div>

                    <div class="reset-rules">
                        <div class="reset-rule-item">
                            <span class="reset-rule-dot @(_isValidLength ? "ok" : "")">@(_isValidLength ? "✓" : "")</span>
                            <span class="@(_isValidLength ? "ok-text" : "")">At least 8 characters</span>
                        </div>
                        <div class="reset-rule-item">
                            <span class="reset-rule-dot @(_passwordsMatch ? "ok" : "")">@(_passwordsMatch ? "✓" : "")</span>
                            <span class="@(_passwordsMatch ? "ok-text" : "")">Passwords match</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="reset-alert reset-alert-error">
                            @_errorMessage
                        </div>
                    }

                    <ValidationSummary class="reset-validation" />

                    <button class="reset-submit" type="submit" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>Reset password</span>
                        }
                    </button>
                </EditForm>
            </div>
        }

        <p class="reset-footer">Having trouble? Contact support.</p>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordFormModel _model = new();
    private bool _isBusy;
    private string? _errorMessage;
    private bool _showPassword;
    private bool _showConfirmPassword;

    private bool _isValidLength => _model.Password.Length >= 8;
    private bool _passwordsMatch =>
        _model.Password.Length > 0 &&
        _model.Password == _model.ConfirmPassword;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;

    private void OnPasswordChanged(ChangeEventArgs _) => _errorMessage = null;

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
            return;

        _isBusy = true;
        _errorMessage = null;

        var request = new ResetPasswordRequest
        {
            Token = Token,
            Password = _model.Password,
            ConfirmPassword = _model.ConfirmPassword
        };

        var result = await ApiClient.ResetPasswordAsync(request);

        _isBusy = false;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/reset-password/success", replace: true);
            return;
        }

        _errorMessage = result.Message;
    }

    private sealed class ResetPasswordFormModel
    {
        [Required(ErrorMessage = "Please fill in all fields.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please fill in all fields.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
