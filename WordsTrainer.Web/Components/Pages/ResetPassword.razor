@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@using WordsTrainer.Contracts.Auth
@using WordsTrainer.Web.Services
@inject PasswordResetApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Create New Password</PageTitle>

<main class="reset-shell">
    <section class="reset-card-wrap">
        <div class="reset-brand">
            <div class="reset-brand-icon">🔒</div>
            <h1>Create new password</h1>
            <p>Your new password must be different from previously used passwords.</p>
        </div>

        @if (string.IsNullOrWhiteSpace(Token))
        {
            <div class="reset-alert reset-alert-error">
                Password reset token is missing or invalid.
            </div>
        }
        else
        {
            <div class="reset-card">
                <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="reset-field">
                        <label for="password">New Password</label>
                        <div class="reset-input-wrap">
                            <span class="reset-input-icon">🔒</span>
                            <InputText id="password"
                                       type="@(_showPassword ? "text" : "password")"
                                       class="reset-input"
                                       @bind-Value="_model.Password"
                                       @oninput="OnPasswordChanged"
                                       placeholder="Enter new password" />
                            <button type="button" class="reset-eye-btn" @onclick="TogglePasswordVisibility">
                                @(_showPassword ? "🙈" : "👁")
                            </button>
                        </div>
                    </div>

                    <div class="reset-field">
                        <label for="confirmPassword">Confirm Password</label>
                        <div class="reset-input-wrap">
                            <span class="reset-input-icon">🔒</span>
                            <InputText id="confirmPassword"
                                       type="@(_showConfirmPassword ? "text" : "password")"
                                       class="reset-input"
                                       @bind-Value="_model.ConfirmPassword"
                                       @oninput="OnPasswordChanged"
                                       placeholder="Confirm new password" />
                            <button type="button" class="reset-eye-btn" @onclick="ToggleConfirmPasswordVisibility">
                                @(_showConfirmPassword ? "🙈" : "👁")
                            </button>
                        </div>
                    </div>

                    <div class="reset-rules">
                        <div class="reset-rule-item">
                            <span class="reset-rule-dot @(_isValidLength ? "ok" : "")">@(_isValidLength ? "✓" : "")</span>
                            <span class="@(_isValidLength ? "ok-text" : "")">At least 8 characters</span>
                        </div>
                        <div class="reset-rule-item">
                            <span class="reset-rule-dot @(_passwordsMatch ? "ok" : "")">@(_passwordsMatch ? "✓" : "")</span>
                            <span class="@(_passwordsMatch ? "ok-text" : "")">Passwords match</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="reset-alert reset-alert-error">
                            @_errorMessage
                        </div>
                    }

                    <ValidationSummary class="reset-validation" />

                    <button class="reset-submit" type="submit" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>Reset password</span>
                        }
                    </button>
                </EditForm>
            </div>
        }

        <p class="reset-footer">Having trouble? Contact support.</p>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordFormModel _model = new();
    private bool _isBusy;
    private string? _errorMessage;
    private bool _showPassword;
    private bool _showConfirmPassword;

    private bool _isValidLength => _model.Password.Length >= 8;
    private bool _passwordsMatch =>
        _model.Password.Length > 0 &&
        _model.Password == _model.ConfirmPassword;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;

    private void OnPasswordChanged(ChangeEventArgs _) => _errorMessage = null;

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
            return;

        _isBusy = true;
        _errorMessage = null;

        var request = new ResetPasswordRequest
        {
            Token = Token,
            Password = _model.Password,
            ConfirmPassword = _model.ConfirmPassword
        };

        var result = await ApiClient.ResetPasswordAsync(request);

        _isBusy = false;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/reset-password/success", replace: true);
            return;
        }

        _errorMessage = result.Message;
    }

    private sealed class ResetPasswordFormModel
    {
        [Required(ErrorMessage = "Please fill in all fields.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please fill in all fields.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
