@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@using WordsTrainer.Contracts.Auth
@using WordsTrainer.Web.Services
@inject PasswordResetApiClient ApiClient

<PageTitle>Reset Password</PageTitle>

<div class="container py-5" style="max-width: 520px;">
    <h1 class="mb-2">Reset Password</h1>
    <p class="text-muted mb-4">Enter your new password and confirm it.</p>

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success" role="alert">@_successMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (string.IsNullOrWhiteSpace(Token))
    {
        <div class="alert alert-warning" role="alert">
            Password reset token is missing or invalid.
        </div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label" for="password">New password</label>
                <InputText id="password" class="form-control" type="password" @bind-Value="_model.Password" />
            </div>

            <div class="mb-4">
                <label class="form-label" for="confirmPassword">Confirm password</label>
                <InputText id="confirmPassword" class="form-control" type="password" @bind-Value="_model.ConfirmPassword" />
            </div>

            <button class="btn btn-primary w-100" type="submit" disabled="@_isBusy">
                @(_isBusy ? "Updating..." : "Change password")
            </button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordFormModel _model = new();
    private bool _isBusy;
    private string? _successMessage;
    private string? _errorMessage;

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
            return;

        _isBusy = true;
        _successMessage = null;
        _errorMessage = null;

        var request = new ResetPasswordRequest
        {
            Token = Token,
            Password = _model.Password,
            ConfirmPassword = _model.ConfirmPassword
        };

        var result = await ApiClient.ResetPasswordAsync(request);

        if (result.IsSuccess)
        {
            _successMessage = result.Message;
            _model.Password = string.Empty;
            _model.ConfirmPassword = string.Empty;
        }
        else
        {
            _errorMessage = result.Message;
        }

        _isBusy = false;
    }

    private sealed class ResetPasswordFormModel
    {
        [Required]
        [MinLength(8)]
        public string Password { get; set; } = string.Empty;

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
