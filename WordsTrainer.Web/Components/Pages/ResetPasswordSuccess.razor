@page "/reset-password/success"

<PageTitle>Password Changed</PageTitle>

<style>
    .reset-shell {
        min-height: 100vh;
        background: #f5f7fa;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .reset-card-wrap {
        width: 100%;
        max-width: 460px;
    }

    .reset-success {
        text-align: center;
        margin-bottom: 24px;
    }

    .reset-success-icon {
        width: 80px;
        height: 80px;
        border-radius: 40px;
        background: #eaf9f0;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
    }

    .reset-success h1 {
        font-size: 40px;
        font-weight: 700;
        color: #1b1e32;
        margin: 0 0 8px 0;
    }

    .reset-success p {
        color: #6f7789;
        font-size: 14px;
        line-height: 1.5;
        margin: 0;
    }

    .reset-card {
        background: #ffffff;
        border: 1px solid #e1e6ef;
        border-radius: 26px;
        padding: 24px;
        box-shadow: 0 10px 26px rgba(20, 31, 61, 0.06);
    }

    .reset-success-panel {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .reset-success-panel-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #eaf0ff;
        color: #3367e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .reset-success-panel-title {
        margin: 0;
        color: #1b1e32;
        font-weight: 600;
    }

    .reset-success-panel-subtitle {
        margin: 0;
        color: #76809a;
        font-size: 13px;
    }

    .reset-submit {
        width: 100%;
        height: 56px;
        border-radius: 18px;
        border: 0;
        background: #3367e8;
        color: #ffffff;
        font-size: 16px;
        font-weight: 600;
        margin-top: 6px;
    }

    .reset-footer {
        text-align: center;
        font-size: 12px;
        color: #8a92a6;
        margin-top: 16px;
    }
</style>

<main class="reset-shell">
    <section class="reset-card-wrap">
        <div class="reset-success">
            <div class="reset-success-icon">✅</div>
            <h1>Password changed!</h1>
            <p>
                Your password has been successfully updated.
                You can now use your new password to sign in to the app.
            </p>
        </div>

        <div class="reset-card">
            <div class="reset-success-panel">
                <div class="reset-success-panel-icon">✔</div>
                <div>
                    <p class="reset-success-panel-title">All set!</p>
                    <p class="reset-success-panel-subtitle">Return to the app to sign in.</p>
                </div>
            </div>

            <button class="reset-submit" type="button" onclick="window.close()">Back to app</button>
        </div>

        <p class="reset-footer">You can close this window.</p>
    </section>
</main>
