<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- COLORS -->

    <Color x:Key="AppBackground">#F5F7FA</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>

    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryDarkColor">#1D4ED8</Color>

    <Color x:Key="TextPrimary">#111827</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>

    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>

    <Color x:Key="BorderColor">#E5E7EB</Color>

    <!-- PAGE -->

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource AppBackground}" />
    </Style>

    <!-- PRIMARY BUTTON -->

    <Style
        x:Key="PrimaryButtonStyle"
        TargetType="Button">

        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />

        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="White" />

        <Setter Property="Padding" Value="16,0" />

    </Style>

    <!-- SECONDARY BUTTON -->

    <Style
        x:Key="SecondaryButtonStyle"
        TargetType="Button">

        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontSize" Value="16" />

        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />

        <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />

    </Style>

    <!-- ANSWER BUTTON -->

    <Style
        x:Key="AnswerButtonStyle"
        TargetType="Button">

        <Setter Property="HeightRequest" Value="58" />
        <Setter Property="CornerRadius" Value="18" />

        <Setter Property="FontSize" Value="20" />

        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />

        <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />

    </Style>

    <!-- ENTRY -->

    <Style TargetType="Entry">

        <Setter Property="HeightRequest" Value="54" />

        <Setter Property="FontSize" Value="16" />

        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />

        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />

        <Setter Property="BackgroundColor" Value="White" />

    </Style>

    <!-- PICKER -->

    <Style TargetType="Picker">

        <Setter Property="HeightRequest" Value="54" />

        <Setter Property="FontSize" Value="16" />

        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />

        <Setter Property="BackgroundColor" Value="White" />

    </Style>

    <!-- CARD BORDER -->

    <Style
        x:Key="CardBorderStyle"
        TargetType="Border">

        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />

        <Setter Property="Stroke" Value="{StaticResource BorderColor}" />

        <Setter Property="StrokeThickness" Value="1" />

        <Setter Property="Padding" Value="20" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>