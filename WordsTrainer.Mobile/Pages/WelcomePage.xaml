<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WordsTrainer.Mobile.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:local="clr-namespace:WordsTrainer.Mobile.Resources.Drawables"
    BackgroundColor="#F5F7FA"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/WordsTrainerTheme.xaml" />
    </ContentPage.Resources>

    <Grid
        Padding="28,40,28,34"
        RowDefinitions="*,Auto"
        RowSpacing="28">

        <!-- Main content -->
        <VerticalStackLayout
            Grid.Row="0"
            MaximumWidthRequest="420"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            TranslationY="-24"
            Spacing="20">

            <!-- Logo -->
            <Border
                WidthRequest="96"
                HeightRequest="96"
                HorizontalOptions="Center"
                BackgroundColor="{StaticResource WtPrimary}"
                StrokeShape="RoundRectangle 28"
                StrokeThickness="0"
                Padding="25">

                <Border.Shadow>
                    <Shadow
                        Brush="#260A54D9"
                        Offset="0,8"
                        Radius="14"
                        Opacity="0.24" />
                </Border.Shadow>

                <Image
                    Source="book_open.svg"
                    WidthRequest="42"
                    HeightRequest="42"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="White" />
                    </Image.Behaviors>
                </Image>

            </Border>

            <!-- Title -->
            <VerticalStackLayout
                Margin="0,14,0,0"
                Spacing="10">

                <Label
                    Text="{Binding TitleText}"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="{StaticResource WtForeground}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="{Binding SubtitleText}"
                    FontSize="18"
                    TextColor="{StaticResource WtMutedText}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="{Binding DescriptionText}"
                    FontSize="18"
                    TextColor="{StaticResource WtMutedText}"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- Feature chips -->
            <HorizontalStackLayout
                Margin="0,15,0,0"
                HorizontalOptions="Center"
                Spacing="10">

                <Border
                    BackgroundColor="#EEF2FF"
                    Padding="11,7"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18">

                    <HorizontalStackLayout Spacing="6">

                        <GraphicsView
                            WidthRequest="15"
                            HeightRequest="15"
                            VerticalOptions="Center">

                            <GraphicsView.Drawable>
                                <local:GlobeDrawable StrokeColor="#2965F1" />
                            </GraphicsView.Drawable>

                        </GraphicsView>

                        <Label
                            Text="{Binding LanguagesText}"
                            FontSize="14"
                            TextColor="{StaticResource WtPrimary}"
                            VerticalTextAlignment="Center" />

                    </HorizontalStackLayout>

                </Border>

                <Border
                    BackgroundColor="#EEF2FF"
                    Padding="11,7"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18">

                    <HorizontalStackLayout Spacing="6">

                        <Label
                            Text="✧"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WtPrimary}"
                            VerticalTextAlignment="Center"
                            Margin="0,-2,0,0" />

                        <Label
                            Text="{Binding PracticeText}"
                            FontSize="14"
                            TextColor="{StaticResource WtPrimary}"
                            VerticalTextAlignment="Center" />

                    </HorizontalStackLayout>

                </Border>

            </HorizontalStackLayout>

            <!-- Word cards -->
            <Grid
                Margin="0,10,0,0"
                HeightRequest="202"
                HorizontalOptions="Center"
                WidthRequest="300">

                <Border
                    WidthRequest="128"
                    HeightRequest="80"
                    TranslationX="-40"
                    TranslationY="2"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource WtCard}"
                    Stroke="{StaticResource WtBorder}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 24">

                    <Border.Shadow>
                        <Shadow
                            Brush="#12000000"
                            Offset="0,4"
                            Radius="8"
                            Opacity="0.12" />
                    </Border.Shadow>

                    <Label
                        Text="Hallo"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="{StaticResource WtPrimary}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>

                <Border
                    WidthRequest="112"
                    HeightRequest="66"
                    TranslationX="70"
                    TranslationY="-46"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource WtCard}"
                    Stroke="{StaticResource WtBorder}"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 22">

                    <Border.Shadow>
                        <Shadow
                            Brush="#12000000"
                            Offset="0,4"
                            Radius="8"
                            Opacity="0.12" />
                    </Border.Shadow>

                    <Label
                        Text="Hello"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource WtMutedText}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>

                <Border
                    WidthRequest="146"
                    HeightRequest="82"
                    TranslationX="22"
                    TranslationY="72"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource WtPrimary}"
                    StrokeThickness="0"
                    Padding="18"
                    StrokeShape="RoundRectangle 25">

                    <Border.Shadow>
                        <Shadow
                            Brush="#200A54D9"
                            Offset="0,6"
                            Radius="10"
                            Opacity="0.18" />
                    </Border.Shadow>

                    <Label
                        Text="Danke!"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>

            </Grid>

        </VerticalStackLayout>

        <!-- Bottom actions -->
        <VerticalStackLayout
            Grid.Row="1"
            Margin="18,0"
            MaximumWidthRequest="420"
            HorizontalOptions="Fill"
            Spacing="12">

            <Button
                Text="{Binding GetStartedText}"
                Style="{StaticResource WtPrimaryButton}"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="17"
                Command="{Binding GetStartedCommand}">

                <Button.Shadow>
                    <Shadow
                        Brush="#260A54D9"
                        Offset="0,8"
                        Radius="14"
                        Opacity="0.22" />
                </Button.Shadow>

            </Button>

            <Button
                Text="{Binding AlreadyHaveAccountText}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource WtMutedText}"
                FontSize="16"
                HeightRequest="44"
                Command="{Binding LoginCommand}" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>
