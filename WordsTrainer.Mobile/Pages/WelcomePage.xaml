<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WordsTrainer.Mobile.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#F5F7FA"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/WordsTrainerTheme.xaml" />
    </ContentPage.Resources>

    <Grid Padding="28">

        <VerticalStackLayout
            MaximumWidthRequest="420"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="28">

            <VerticalStackLayout Spacing="20">

                <Border
                    WidthRequest="96"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource WtPrimary}"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    Padding="24">

                    <Image
                        Source="book_open.svg"
                        WidthRequest="42"
                        HeightRequest="42"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>

                    </Image>

                </Border>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="WordsTrainer"
                        FontSize="34"
                        FontAttributes="Bold"
                        TextColor="{StaticResource WtForeground}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Master new words every day."
                        FontSize="19"
                        TextColor="{StaticResource WtMutedText}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Build your vocabulary, one word at a time."
                        FontSize="18"
                        TextColor="{StaticResource WtMutedText}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="10">

                    <Border
                        BackgroundColor="#EEF2FF"
                        Padding="12,7"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">

                        <Label
                            Text="🌐 8 Languages"
                            FontSize="14"
                            TextColor="{StaticResource WtPrimary}" />

                    </Border>

                    <Border
                        BackgroundColor="#EEF2FF"
                        Padding="12,7"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">

                        <Label
                            Text="✨ Daily Practice"
                            FontSize="14"
                            TextColor="{StaticResource WtPrimary}" />

                    </Border>

                </HorizontalStackLayout>

                <Grid
                    HeightRequest="190"
                    HorizontalOptions="Center"
                    WidthRequest="300">

                    <Border
                        WidthRequest="132"
                        HeightRequest="78"
                        TranslationX="-38"
                        TranslationY="8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource WtCard}"
                        Stroke="{StaticResource WtBorder}"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 24">

                        <Label
                            Text="Hallo"
                            FontSize="25"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WtPrimary}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <Border
                        WidthRequest="112"
                        HeightRequest="66"
                        TranslationX="70"
                        TranslationY="-38"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource WtCard}"
                        Stroke="{StaticResource WtBorder}"
                        StrokeThickness="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 22">

                        <Label
                            Text="Hello"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WtMutedText}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <Border
                        WidthRequest="146"
                        HeightRequest="82"
                        TranslationX="22"
                        TranslationY="70"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource WtPrimary}"
                        StrokeThickness="0"
                        Padding="18"
                        StrokeShape="RoundRectangle 24">

                        <Label
                            Text="Danke!"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                </Grid>

            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14">

                <Button
                    Text="Get Started"
                    Style="{StaticResource WtPrimaryButton}"
                    HeightRequest="56"
                    CornerRadius="24"
                    Command="{Binding GetStartedCommand}" />

                <Button
                    Text="I already have an account"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource WtMutedText}"
                    FontSize="16"
                    HeightRequest="44"
                    Command="{Binding LoginCommand}" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </Grid>

</ContentPage>