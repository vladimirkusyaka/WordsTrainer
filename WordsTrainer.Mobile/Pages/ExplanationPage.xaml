<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WordsTrainer.Mobile.Pages.ExplanationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FA"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/WordsTrainerTheme.xaml" />
    </ContentPage.Resources>

    <Grid Padding="20">

        <ScrollView>
            <VerticalStackLayout
                MaximumWidthRequest="460"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="16">

                <!-- TOP BAR -->

                <Grid ColumnDefinitions="Auto,*">

                    <Button
                        Grid.Column="0"
                        Text="←"
                        FontSize="20"
                        HeightRequest="38"
                        WidthRequest="46"
                        CornerRadius="14"
                        BackgroundColor="{StaticResource WtCard}"
                        TextColor="{StaticResource WtForeground}"
                        BorderColor="{StaticResource WtBorder}"
                        BorderWidth="1"
                        Clicked="BackClicked" />

                    <Label
                        Grid.Column="1"
                        Text="Word explanation"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{StaticResource WtForeground}"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center" />

                </Grid>

                <!-- WORD CARD -->

                <Border
                    BackgroundColor="{StaticResource WtCard}"
                    Stroke="{StaticResource WtBorder}"
                    StrokeThickness="1"
                    Padding="24"
                    StrokeShape="RoundRectangle 28">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="{Binding TargetWord}"
                            FontSize="42"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WtForeground}"
                            HorizontalTextAlignment="Center" />

                        <Button
                            Text="🔊 Listen"
                            HeightRequest="44"
                            CornerRadius="14"
                            BackgroundColor="{StaticResource WtPrimary}"
                            TextColor="White"
                            FontSize="16"
                            Command="{Binding PlayAudioCommand}" />

                    </VerticalStackLayout>

                </Border>

                <!-- TRANSLATION CARD -->

                <Border
                    BackgroundColor="{StaticResource WtCard}"
                    Stroke="{StaticResource WtBorder}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Translation"
                            FontSize="13"
                            TextColor="{StaticResource WtMutedText}" />

                        <Label
                            Text="{Binding NativeTranslation}"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WtForeground}" />

                    </VerticalStackLayout>

                </Border>

                <!-- EXPLANATION CARD -->

                <Border
                    BackgroundColor="{StaticResource WtCard}"
                    Stroke="{StaticResource WtBorder}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="Meaning"
                            FontSize="13"
                            TextColor="{StaticResource WtMutedText}" />

                        <Label
                            Text="{Binding Explanation}"
                            FontSize="18"
                            LineBreakMode="WordWrap"
                            TextColor="{StaticResource WtForeground}" />

                    </VerticalStackLayout>

                </Border>

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}" />

                <Label
                    Text="{Binding Message}"
                    FontSize="14"
                    TextColor="{StaticResource WtMutedText}"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>