<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WordsTrainer.Mobile.Pages.ExplanationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#F5F7FA"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/WordsTrainerTheme.xaml" />
    </ContentPage.Resources>

    <Grid
        Padding="14,18,14,18"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="0">

        <!-- Back -->
        <HorizontalStackLayout
            Grid.Row="0"
            Spacing="6"
            HeightRequest="42"
            VerticalOptions="Center">

            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="BackTapped" />
            </HorizontalStackLayout.GestureRecognizers>

            <Image
                Source="arrow_left.svg"
                WidthRequest="22"
                HeightRequest="22"
                VerticalOptions="Center">

                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                </Image.Behaviors>

            </Image>

            <Label
                Text="Back"
                FontSize="15"
                TextColor="{StaticResource WtMutedText}"
                VerticalTextAlignment="Center" />

        </HorizontalStackLayout>

        <!-- Content -->
        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never"
            HorizontalScrollBarVisibility="Never">

            <VerticalStackLayout
                MaximumWidthRequest="430"
                HorizontalOptions="Fill"
                Spacing="18"
                Margin="0,10,0,18">

                <!-- Word card -->
                <Border
                    BackgroundColor="{StaticResource WtCard}"
                    Stroke="{StaticResource WtBorder}"
                    StrokeThickness="1"
                    Padding="24,22"
                    StrokeShape="RoundRectangle 24">

                    <Border.Shadow>
                        <Shadow
                            Brush="#10000000"
                            Offset="0,3"
                            Radius="7"
                            Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">

                        <Border
                            BackgroundColor="#EAF0FF"
                            StrokeThickness="0"
                            Padding="12,5"
                            StrokeShape="RoundRectangle 14"
                            HorizontalOptions="Start"
                            IsVisible="{Binding HasQuestionLevel}">

                            <Label
                                Text="{Binding QuestionLevel}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{StaticResource WtPrimary}" />

                        </Border>

                        <Label
                            Text="{Binding TargetWord}"
                            FontSize="31"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WtForeground}"
                            HorizontalTextAlignment="Start"
                            LineBreakMode="WordWrap"
                            MaxLines="3"
                            FontAutoScalingEnabled="False" />

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <Label
                                Grid.Column="0"
                                Text="{Binding NativeTranslation}"
                                FontSize="21"
                                TextColor="{StaticResource WtPrimary}"
                                VerticalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                MaxLines="2"
                                FontAutoScalingEnabled="False" />

                            <Border
                                Grid.Column="1"
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="#EAF0FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 21"
                                IsVisible="False">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PlayAudioCommand}" />
                                </Border.GestureRecognizers>

                                <Label
                                    Text="◖))"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource WtPrimary}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    InputTransparent="True" />

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- Explanation card -->
                <Border
                    BackgroundColor="{StaticResource WtCard}"
                    Stroke="{StaticResource WtBorder}"
                    StrokeThickness="1"
                    Padding="24,22"
                    StrokeShape="RoundRectangle 24">

                    <Border.Shadow>
                        <Shadow
                            Brush="#10000000"
                            Offset="0,3"
                            Radius="7"
                            Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <HorizontalStackLayout Spacing="12">

                            <Border
                                WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="#FFF7E8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20">

                                <Label
                                    Text="!"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#F59E0B"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>

                            <Label
                                Text="Explanation"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{StaticResource WtForeground}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>

                        <Label
                            Text="{Binding Explanation}"
                            FontSize="17"
                            LineHeight="1.35"
                            LineBreakMode="WordWrap"
                            TextColor="{StaticResource WtMutedText}" />

                    </VerticalStackLayout>

                </Border>

                <!-- Loading and message -->
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource WtPrimary}"
                    HorizontalOptions="Center" />

                <Label
                    Text="{Binding Message}"
                    IsVisible="{Binding HasMessage}"
                    FontSize="14"
                    TextColor="{StaticResource WtMutedText}"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>

        </ScrollView>

        <!-- Bottom action -->
        <VerticalStackLayout
            Grid.Row="2"
            MaximumWidthRequest="430"
            HorizontalOptions="Fill"
            Spacing="8"
            Margin="0,12,0,0">

            <Button
                Text="Got it, continue"
                Style="{StaticResource WtPrimaryButton}"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="17"
                IsEnabled="{Binding IsNotBusy}"
                Clicked="ContinueClicked">

                <Button.Shadow>
                    <Shadow
                        Brush="#200A54D9"
                        Offset="0,6"
                        Radius="10"
                        Opacity="0.18" />
                </Button.Shadow>

            </Button>

            <Label
                Text="This word will be marked for review"
                FontSize="13"
                TextColor="{StaticResource WtMutedText}"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>
