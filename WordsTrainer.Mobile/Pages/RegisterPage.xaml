<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WordsTrainer.Mobile.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#F5F7FA"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/WordsTrainerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RegistrationFieldLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource WtForeground}" />
            </Style>

            <Style x:Key="RegistrationFieldBorderStyle" TargetType="Border">
                <Setter Property="HeightRequest" Value="58" />
                <Setter Property="BackgroundColor" Value="{StaticResource WtCard}" />
                <Setter Property="Stroke" Value="{StaticResource WtBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 29" />
            </Style>

            <Style x:Key="RegistrationEntryStyle" TargetType="Entry">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource WtForeground}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource WtMutedText}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="ClearButtonVisibility" Value="Never" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="RegistrationIconStyle" TargetType="Image">
                <Setter Property="WidthRequest" Value="20" />
                <Setter Property="HeightRequest" Value="20" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="PasswordEyeStyle" TargetType="ImageButton">
                <Setter Property="WidthRequest" Value="22" />
                <Setter Property="HeightRequest" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid
        Padding="24,24,24,28"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="0">

        <!-- Top navigation -->
        <Grid
            Grid.Row="0"
            MaximumWidthRequest="430"
            HorizontalOptions="Fill"
            ColumnDefinitions="Auto,*,Auto"
            HeightRequest="40">

            <HorizontalStackLayout
                Grid.Column="0"
                Spacing="6"
                VerticalOptions="Center">

                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PreviousStepCommand}" />
                </HorizontalStackLayout.GestureRecognizers>

                <Image
                    Source="arrow_left.svg"
                    WidthRequest="22"
                    HeightRequest="22"
                    VerticalOptions="Center">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                    </Image.Behaviors>
                </Image>

                <Label
                Text="{Binding BackText}"
                FontSize="15"
                TextColor="{StaticResource WtMutedText}"
                VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <Label
                Grid.Column="2"
                Text="{Binding StepCounterText}"
                FontSize="14"
                TextColor="{StaticResource WtMutedText}"
                VerticalTextAlignment="Center" />

        </Grid>

        <!-- Header and progress -->
        <VerticalStackLayout
            Grid.Row="1"
            MaximumWidthRequest="430"
            HorizontalOptions="Fill"
            Margin="0,26,0,0"
            Spacing="0">

            <Label
                Text="{Binding StepTitle}"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="{StaticResource WtForeground}" />

            <Label
                Text="{Binding StepSubtitle}"
                Margin="0,8,0,0"
                FontSize="17"
                TextColor="{StaticResource WtMutedText}" />

            <Grid
                Margin="0,24,0,0"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="8">

                <BoxView
                    Grid.Column="0"
                    HeightRequest="5"
                    CornerRadius="3"
                    Color="{Binding Step1Color}" />

                <BoxView
                    Grid.Column="1"
                    HeightRequest="5"
                    CornerRadius="3"
                    Color="{Binding Step2Color}" />

                <BoxView
                    Grid.Column="2"
                    HeightRequest="5"
                    CornerRadius="3"
                    Color="{Binding Step3Color}" />

            </Grid>

        </VerticalStackLayout>

        <!-- Step content -->
        <Grid
            Grid.Row="2"
            MaximumWidthRequest="430"
            HorizontalOptions="Fill"
            Margin="0,40,0,0">

            <!-- STEP 1 -->
            <VerticalStackLayout
                IsVisible="{Binding IsStep1}"
                Spacing="16">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="{Binding EmailText}"
                        Style="{StaticResource RegistrationFieldLabelStyle}" />

                    <Border Style="{StaticResource RegistrationFieldBorderStyle}">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                            <Image
                                Source="mail.svg"
                                Style="{StaticResource RegistrationIconStyle}">

                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                                </Image.Behaviors>

                            </Image>

                            <Entry
                                Grid.Column="1"
                                Style="{StaticResource RegistrationEntryStyle}"
                                Placeholder="{Binding EmailPlaceholderText}"
                                Keyboard="Email"
                                Text="{Binding Email}" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="{Binding PasswordText}"
                        Style="{StaticResource RegistrationFieldLabelStyle}" />

                    <Border Style="{StaticResource RegistrationFieldBorderStyle}">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <Image
                                Source="lock.svg"
                                Style="{StaticResource RegistrationIconStyle}">

                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                                </Image.Behaviors>

                            </Image>

                            <Entry
                                x:Name="PasswordEntry"
                                Grid.Column="1"
                                Style="{StaticResource RegistrationEntryStyle}"
                                Placeholder="{Binding PasswordPlaceholderText}"
                                IsPassword="True"
                                Text="{Binding Password}" />

                            <ImageButton
                                Grid.Column="2"
                                Style="{StaticResource PasswordEyeStyle}"
                                Source="eye.svg"
                                Clicked="TogglePasswordClicked" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="{Binding ConfirmPasswordText}"
                        Style="{StaticResource RegistrationFieldLabelStyle}" />

                    <Border Style="{StaticResource RegistrationFieldBorderStyle}">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <Image
                                Source="lock.svg"
                                Style="{StaticResource RegistrationIconStyle}">

                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                                </Image.Behaviors>

                            </Image>

                            <Entry
                                x:Name="ConfirmPasswordEntry"
                                Grid.Column="1"
                                Style="{StaticResource RegistrationEntryStyle}"
                                Placeholder="{Binding ConfirmPasswordPlaceholderText}"
                                IsPassword="True"
                                Text="{Binding ConfirmPassword}" />

                            <ImageButton
                                Grid.Column="2"
                                Style="{StaticResource PasswordEyeStyle}"
                                Source="eye.svg"
                                Clicked="ToggleConfirmPasswordClicked" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- STEP 2 -->
            <VerticalStackLayout
                IsVisible="{Binding IsStep2}"
                Spacing="22">

                <!-- Native language -->
                <VerticalStackLayout Spacing="10">

                    <HorizontalStackLayout Spacing="8">

                        <Image
                            Source="globe.svg"
                            WidthRequest="18"
                            HeightRequest="18"
                            VerticalOptions="Center">

                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                            </Image.Behaviors>

                        </Image>

                        <Label
                            Text="{Binding NativeLanguageText}"
                            Style="{StaticResource WtSectionLabelStyle}" />

                    </HorizontalStackLayout>

                    <Border Style="{StaticResource WtPickerBorderStyle}">

                        <Grid ColumnDefinitions="*,42">

                            <Picker
                                x:Name="NativeLanguagePicker"
                                Grid.Column="0"
                                Style="{StaticResource WtPickerStyle}"
                                Title="Select your native language"
                                ItemsSource="{Binding Languages}"
                                ItemDisplayBinding="{Binding NativeName}"
                                SelectedItem="{Binding SelectedNativeLanguage}" />

                            <Grid
                                Grid.Column="1"
                                BackgroundColor="Transparent">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OpenNativeLanguagePickerTapped" />
                                </Grid.GestureRecognizers>

                                <Image
                                    Source="chevron_down.svg"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    InputTransparent="True">

                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                                    </Image.Behaviors>

                                </Image>

                            </Grid>

                        </Grid>

                    </Border>

                </VerticalStackLayout>

                <!-- Target language -->
                <VerticalStackLayout Spacing="10">

                    <HorizontalStackLayout Spacing="8">

                        <Image
                            Source="globe.svg"
                            WidthRequest="18"
                            HeightRequest="18"
                            VerticalOptions="Center">

                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                            </Image.Behaviors>

                        </Image>

                        <Label
                            Text="{Binding TargetLanguageText}"
                            Style="{StaticResource WtSectionLabelStyle}" />

                    </HorizontalStackLayout>

                    <Border Style="{StaticResource WtPickerBorderStyle}">

                        <Grid ColumnDefinitions="*,42">

                            <Picker
                                x:Name="TargetLanguagePicker"
                                Grid.Column="0"
                                Style="{StaticResource WtPickerStyle}"
                                Title="Select language to learn"
                                ItemsSource="{Binding Languages}"
                                ItemDisplayBinding="{Binding NativeName}"
                                SelectedItem="{Binding SelectedTargetLanguage}" />

                            <Grid
                                Grid.Column="1"
                                BackgroundColor="Transparent">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OpenTargetLanguagePickerTapped" />
                                </Grid.GestureRecognizers>

                                <Image
                                    Source="chevron_down.svg"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    InputTransparent="True">

                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                                    </Image.Behaviors>

                                </Image>

                            </Grid>

                        </Grid>

                    </Border>

                </VerticalStackLayout>

                <!-- Current level -->
                <VerticalStackLayout Spacing="10">

                    <HorizontalStackLayout Spacing="8">

                        <Image
                            Source="chart_column.svg"
                            WidthRequest="18"
                            HeightRequest="18"
                            VerticalOptions="Center">

                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                            </Image.Behaviors>

                        </Image>

                        <Label
                            Text="{Binding CurrentLevelText}"
                            Style="{StaticResource WtSectionLabelStyle}" />

                    </HorizontalStackLayout>

                    <Border Style="{StaticResource WtPickerBorderStyle}">

                        <Grid ColumnDefinitions="*,42">

                            <Picker
                                x:Name="LevelPicker"
                                Grid.Column="0"
                                Style="{StaticResource WtPickerStyle}"
                                Title="Select your level"
                                ItemsSource="{Binding Levels}"
                                ItemDisplayBinding="{Binding Code}"
                                SelectedItem="{Binding SelectedLevel}" />

                            <Grid
                                Grid.Column="1"
                                BackgroundColor="Transparent">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OpenLevelPickerTapped" />
                                </Grid.GestureRecognizers>

                                <Image
                                    Source="chevron_down.svg"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    InputTransparent="True">

                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                                    </Image.Behaviors>

                                </Image>

                            </Grid>

                        </Grid>

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- STEP 3 -->
            <VerticalStackLayout
    IsVisible="{Binding IsStep3}"
    Spacing="8">

                <Border
        BackgroundColor="{StaticResource WtCard}"
        Stroke="{StaticResource WtBorder}"
        StrokeThickness="1"
        Padding="20"
        StrokeShape="RoundRectangle 24">

                    <VerticalStackLayout Spacing="18">

                        <Label
                Text="{Binding AccountSummaryText}"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="{StaticResource WtForeground}" />

                        <!-- Account email -->
                        <Grid ColumnDefinitions="42,*" ColumnSpacing="12">

                            <Border
                    WidthRequest="42"
                    HeightRequest="42"
                    BackgroundColor="#EEF2FF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 21">

                                <Image
                        Source="mail.svg"
                        WidthRequest="19"
                        HeightRequest="19"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource WtPrimary}" />
                                    </Image.Behaviors>

                                </Image>

                            </Border>

                            <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="2">

                                <Label
                        Text="{Binding EmailText}"
                        FontSize="13"
                        TextColor="{StaticResource WtMutedText}" />

                                <Label
                        Text="{Binding Email}"
                        FontSize="16"
                        TextColor="{StaticResource WtForeground}"
                        LineBreakMode="TailTruncation" />

                            </VerticalStackLayout>

                        </Grid>

                        <BoxView
                HeightRequest="1"
                Color="{StaticResource WtBorder}" />

                        <!-- Learning preferences -->
                        <Grid
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="14">

                            <Label
                    Grid.Row="0"
                    Text="{Binding NativeLanguageText}"
                    FontSize="15"
                    TextColor="{StaticResource WtMutedText}" />

                            <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding SelectedNativeLanguage.NativeName}"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource WtForeground}" />

                            <Label
                    Grid.Row="1"
                    Text="{Binding LearningText}"
                    FontSize="15"
                    TextColor="{StaticResource WtMutedText}" />

                            <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding SelectedTargetLanguage.NativeName}"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource WtForeground}" />

                            <Label
                                Grid.Row="2"
                                Text="{Binding CurrentLevelText}"
                                FontSize="15"
                                TextColor="{StaticResource WtMutedText}" 
                                VerticalTextAlignment="Center" />
                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                MinimumWidthRequest="44"
                                HeightRequest="30"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                BackgroundColor="#EEF2FF"
                                StrokeThickness="0"
                                Padding="10,0"
                                StrokeShape="RoundRectangle 15">

                                <Label
                                    Text="{Binding SelectedLevel.Code}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource WtPrimary}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                FontSize="14"
                TextColor="{StaticResource WtError}"
                HorizontalTextAlignment="Center"
                VerticalOptions="End"
                Margin="0,0,0,8" />

        </Grid>

        <!-- Bottom actions -->
        <VerticalStackLayout
            Grid.Row="3"
            MaximumWidthRequest="430"
            HorizontalOptions="Fill"
            Spacing="10"
            Margin="0,24,0,10">

            <Button
                Text="{Binding ContinueText}"
                IsVisible="{Binding IsStep1}"
                Style="{StaticResource WtPrimaryButton}"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="17"

                Command="{Binding NextStepCommand}">

                <Button.Shadow>
                    <Shadow
                        Brush="#200A54D9"
                        Offset="0,6"
                        Radius="10"
                        Opacity="0.18" />
                </Button.Shadow>

            </Button>

            <Button
                Text="{Binding ContinueText}"
                IsVisible="{Binding IsStep2}"
                Style="{StaticResource WtPrimaryButton}"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="17"
                Command="{Binding NextStepCommand}">

                <Button.Shadow>
                    <Shadow
                        Brush="#200A54D9"
                        Offset="0,6"
                        Radius="10"
                        Opacity="0.18" />
                </Button.Shadow>

            </Button>

            <Button
                Text="{Binding CreateAccountText}"
                IsVisible="{Binding IsStep3}"
                Style="{StaticResource WtPrimaryButton}"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="17"
                Command="{Binding RegisterCommand}">

                <Button.Shadow>
                    <Shadow
                        Brush="#200A54D9"
                        Offset="0,6"
                        Radius="10"
                        Opacity="0.18" />
                </Button.Shadow>

            </Button>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="4">

                <Label
                    Text="{Binding AlreadyHaveAccountText}"
                    FontSize="16"
                    TextColor="{StaticResource WtMutedText}"
                    VerticalTextAlignment="Center" />

                <Label
                    Text="{Binding SignInText}"
                    FontSize="16"
                    TextColor="{StaticResource WtPrimary}"
                    VerticalTextAlignment="Center">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>

                </Label>

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
