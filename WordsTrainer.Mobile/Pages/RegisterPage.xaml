<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WordsTrainer.Mobile.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FA"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/WordsTrainerTheme.xaml" />
    </ContentPage.Resources>

    <Grid Padding="20">

        <ScrollView>
            <VerticalStackLayout
                MaximumWidthRequest="500"
                HorizontalOptions="Center"
                Spacing="12"
                Padding="0,4">

                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Create account"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="{StaticResource WtForeground}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Choose your languages and start learning"
                        FontSize="16"
                        TextColor="{StaticResource WtMutedText}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border
                    BackgroundColor="{StaticResource WtCard}"
                    Stroke="{StaticResource WtBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 28"
                    WidthRequest="380"
                    Padding="18">

                    <VerticalStackLayout Spacing="7">

                        <Entry
                            Placeholder="Email"
                            Keyboard="Email"
                            Text="{Binding Email}"
                            HeightRequest="40"
                            FontSize="14"
                            BackgroundColor="#F9FAFB" />

                        <Entry
                            Placeholder="Password"
                            IsPassword="True"
                            Text="{Binding Password}"
                            HeightRequest="40"
                            FontSize="14"
                            BackgroundColor="#F9FAFB" />

                        <Entry
                            Placeholder="Confirm password"
                            IsPassword="True"
                            Text="{Binding ConfirmPassword}"
                            HeightRequest="40"
                            FontSize="14"
                            BackgroundColor="#F9FAFB" />

                        <Label
                            Margin="0,2,0,0"
                            Text="Native language"
                            FontSize="12"
                            TextColor="{StaticResource WtMutedText}" />

                        <Picker
                            ItemsSource="{Binding Languages}"
                            ItemDisplayBinding="{Binding NativeName}"
                            SelectedItem="{Binding SelectedNativeLanguage}"
                            HeightRequest="40"
                            FontSize="14"
                            BackgroundColor="#F9FAFB" />

                        <Label
                            Margin="0,2,0,0"
                            Text="Target language"
                            FontSize="12"
                            TextColor="{StaticResource WtMutedText}" />

                        <Picker
                            ItemsSource="{Binding Languages}"
                            ItemDisplayBinding="{Binding NativeName}"
                            SelectedItem="{Binding SelectedTargetLanguage}"
                            HeightRequest="40"
                            FontSize="14"
                            BackgroundColor="#F9FAFB" />

                        <Label
                            Margin="0,2,0,0"
                            Text="Level"
                            FontSize="12"
                            TextColor="{StaticResource WtMutedText}" />

                        <Picker
                            ItemsSource="{Binding Levels}"
                            ItemDisplayBinding="{Binding Code}"
                            SelectedItem="{Binding SelectedLevel}"
                            HeightRequest="40"
                            FontSize="14"
                            BackgroundColor="#F9FAFB" />

                        <Button
                            Margin="0,10,0,0"
                            Text="Register"
                            HeightRequest="44"
                            CornerRadius="16"
                            Style="{StaticResource WtPrimaryButton}"
                            Command="{Binding RegisterCommand}" />

                        <Button
                            Text="Already have account? Login"
                            HeightRequest="44"
                            CornerRadius="16"
                            Style="{StaticResource WtSecondaryButton}"
                            Command="{Binding GoToLoginCommand}" />

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}" />

                        <Label
                            Text="{Binding ErrorMessage}"
                            FontSize="12"
                            TextColor="{StaticResource WtError}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>