<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WordsTrainer.Mobile.Pages.TrainingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FA"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/WordsTrainerTheme.xaml" />
    </ContentPage.Resources>

    <Grid Padding="20">

        <ScrollView>
            <VerticalStackLayout
                MaximumWidthRequest="420"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="16">

                <!-- TOP BAR -->

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Grid.Column="0" Spacing="2">

                        <Label
                            Text="{Binding AppTitle}"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WtForeground}" />

                        <Label
                            Text="{Binding AppSubtitle}"
                            FontSize="14"
                            TextColor="{StaticResource WtMutedText}" />

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="{Binding LogoutText}"
                        FontSize="12"
                        HeightRequest="34"
                        WidthRequest="78"
                        Padding="8,0"
                        CornerRadius="10"
                        BackgroundColor="{StaticResource WtCard}"
                        TextColor="{StaticResource WtMutedText}"
                        BorderColor="{StaticResource WtBorder}"
                        BorderWidth="1"
                        Command="{Binding LogoutCommand}" />

                </Grid>

                <!-- STATS CARD -->

                <Border
                    BackgroundColor="{StaticResource WtCard}"
                    Stroke="{StaticResource WtBorder}"
                    StrokeThickness="1"
                    Padding="14"
                    StrokeShape="RoundRectangle 22">

                    <Grid ColumnDefinitions="*,*,*,*">

                        <VerticalStackLayout Grid.Column="0" Spacing="3">

                            <Label
                                Text="{Binding TodayText}"
                                FontSize="12"
                                TextColor="{StaticResource WtMutedText}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="{Binding AnsweredToday}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{StaticResource WtForeground}"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="3">

                            <Label
                                Text="{Binding CorrectText}"
                                FontSize="12"
                                TextColor="{StaticResource WtMutedText}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="{Binding CorrectToday}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{StaticResource WtForeground}"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="3">

                            <Label
                                Text="{Binding NewText}"
                                FontSize="12"
                                TextColor="{StaticResource WtMutedText}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="{Binding NewCorrectToday}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{StaticResource WtForeground}"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" Spacing="3">

                            <Label
                                Text="{Binding LearnedText}"
                                FontSize="12"
                                TextColor="{StaticResource WtMutedText}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="{Binding LearnedTotal}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{StaticResource WtForeground}"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

                <!-- MESSAGE -->

                <Label
                    Text="{Binding Message}"
                    FontSize="14"
                    TextColor="{StaticResource WtMutedText}"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    MaxLines="2" />

                <!-- EMPTY STATE -->

                <VerticalStackLayout
                    IsVisible="{Binding HasNoQuestion}"
                    Spacing="12"
                    Padding="0,36"
                    VerticalOptions="Center">

                    <Label
                        Text="🎉"
                        FontSize="60"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="{Binding TrainingCompleteText}"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource WtForeground}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="{Binding Message}"
                        FontSize="16"
                        TextColor="{StaticResource WtMutedText}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

                <!-- QUESTION STATE -->

                <VerticalStackLayout
                    IsVisible="{Binding HasQuestion}"
                    Spacing="14">

                    <!-- WORD CARD -->

                    <Border
                        BackgroundColor="{StaticResource WtCard}"
                        Stroke="{StaticResource WtBorder}"
                        StrokeThickness="1"
                        Padding="22,18"
                        StrokeShape="RoundRectangle 26">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="{Binding TranslateWordText}"
                                FontSize="13"
                                TextColor="{StaticResource WtMutedText}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="{Binding QuestionText}"
                                FontSize="40"
                                FontAttributes="Bold"
                                TextColor="{StaticResource WtForeground}"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- ANSWERS -->

                    <CollectionView
                        ItemsSource="{Binding Options}"
                        SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Button
                                    Style="{StaticResource WtAnswerButton}"
                                    HeightRequest="48"
                                    CornerRadius="14"
                                    FontSize="17"
                                    Margin="0,4"
                                    Text="{Binding Text}"
                                    Command="{Binding BindingContext.AnswerCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <!-- EXPLANATION -->

                    <Button
                        Text="{Binding DontKnowText}"
                        Style="{StaticResource WtSecondaryButton}"
                        HeightRequest="44"
                        CornerRadius="14"
                        FontSize="15"
                        Command="{Binding ShowExplanationCommand}" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>