<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WordsTrainer.Mobile.Pages.TrainingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource WtBackground}"
    Title="Training">

    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/WordsTrainerTheme.xaml" />
    </ContentPage.Resources>

    <Grid Padding="20">

        <ScrollView>
            <VerticalStackLayout
                MaximumWidthRequest="420"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="18">

                <!-- TOP BAR -->

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label
                            Text="WordsTrainer"
                            Style="{StaticResource WtTitleLabel}" />

                        <Label
                            Text="Daily vocabulary practice"
                            Style="{StaticResource WtSubtitleLabel}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="Logout"
                        FontSize="12"
                        HeightRequest="34"
                        WidthRequest="78"
                        Padding="8,0"
                        CornerRadius="10"
                        BackgroundColor="{StaticResource WtCard}"
                        TextColor="{StaticResource WtMutedText}"
                        BorderColor="{StaticResource WtBorder}"
                        BorderWidth="1"
                        Command="{Binding LogoutCommand}" />
                </Grid>

                <!-- STATS CARD -->

                <Border Style="{StaticResource WtCardBorder}" Padding="16">
                    <Grid ColumnDefinitions="*,*,*,*">

                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label
                                Text="Today"
                                Style="{StaticResource WtSmallMutedLabel}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="{Binding AnsweredToday}"
                                Style="{StaticResource WtStatValueLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label
                                Text="Correct"
                                Style="{StaticResource WtSmallMutedLabel}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="{Binding CorrectToday}"
                                Style="{StaticResource WtStatValueLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label
                                Text="New"
                                Style="{StaticResource WtSmallMutedLabel}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="{Binding NewCorrectToday}"
                                Style="{StaticResource WtStatValueLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" Spacing="4">
                            <Label
                                Text="Learned"
                                Style="{StaticResource WtSmallMutedLabel}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="{Binding LearnedTotal}"
                                Style="{StaticResource WtStatValueLabel}" />
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!-- MESSAGE -->

                <Label
                    Text="{Binding Message}"
                    FontSize="16"
                    TextColor="{StaticResource WtMutedText}"
                    HorizontalTextAlignment="Center" />

                <!-- EMPTY STATE -->

                <VerticalStackLayout
                    IsVisible="{Binding HasNoQuestion}"
                    Spacing="14"
                    Padding="0,40"
                    VerticalOptions="Center">

                    <Label
                        Text="🎉"
                        FontSize="64"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Training complete"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="{StaticResource WtForeground}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="{Binding Message}"
                        FontSize="17"
                        TextColor="{StaticResource WtMutedText}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

                <!-- QUESTION STATE -->

                <VerticalStackLayout
                    IsVisible="{Binding HasQuestion}"
                    Spacing="18">

                    <!-- WORD CARD -->

                    <Border
                        BackgroundColor="{StaticResource WtCard}"
                        Stroke="{StaticResource WtBorder}"
                        StrokeThickness="1"
                        Padding="24,22"
                        StrokeShape="RoundRectangle 28">

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Translate this word"
                                FontSize="14"
                                TextColor="{StaticResource WtMutedText}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="{Binding QuestionText}"
                                FontSize="44"
                                FontAttributes="Bold"
                                TextColor="{StaticResource WtForeground}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    </Border>

                    <!-- ANSWERS -->

                    <CollectionView
                        ItemsSource="{Binding Options}"
                        SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Style="{StaticResource WtAnswerButton}"
                                    Margin="0,6"
                                    Text="{Binding Text}"
                                    Command="{Binding BindingContext.AnswerCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <!-- EXPLANATION -->

                    <Button
                        Text="I don't know this word"
                        Style="{StaticResource WtSecondaryButton}"
                        Command="{Binding ShowExplanationCommand}" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>