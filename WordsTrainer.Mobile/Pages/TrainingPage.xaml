<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WordsTrainer.Mobile.Pages.TrainingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#F5F7FA"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/WordsTrainerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StatValueStyle" TargetType="Label">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource WtForeground}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatCaptionStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource WtMutedText}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatIconLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="18,12,18,10">

        <Grid
            MaximumWidthRequest="430"
            HorizontalOptions="Center"
            VerticalOptions="Fill">

            <ScrollView
    VerticalScrollBarVisibility="Never"
    HorizontalScrollBarVisibility="Never">

                <VerticalStackLayout
                    HorizontalOptions="Fill"
                    Spacing="0">

                    <!-- Header -->
                    <Grid
                        ColumnDefinitions="*,Auto"
                        HorizontalOptions="Fill">

                        <Label
                            Grid.Column="0"
                            Text="Training"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WtForeground}"
                            VerticalTextAlignment="Center" />

                        <HorizontalStackLayout
                            Grid.Column="1"
                            Spacing="6"
                            HeightRequest="36"
                            VerticalOptions="Center">

                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>

                            <Image
                                Source="arrow_left.svg"
                                WidthRequest="16"
                                HeightRequest="16"
                                Rotation="180"
                                VerticalOptions="Center">

                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource WtMutedText}" />
                                </Image.Behaviors>

                            </Image>

                            <Label
                                Text="Logout"
                                FontSize="14"
                                TextColor="{StaticResource WtMutedText}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>

                    </Grid>

                    <!-- Progress -->
                    <Grid
                        Margin="0,10,0,0"
                        RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        RowSpacing="7"
                        HorizontalOptions="Fill">

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding ProgressText}"
                            FontSize="12"
                            TextColor="{StaticResource WtMutedText}" />

                        <Grid
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            HeightRequest="5"
                            HorizontalOptions="Fill">

                            <BoxView
                                Color="#E6EBF5"
                                CornerRadius="3"
                                HorizontalOptions="Fill" />

                            <ProgressBar
                                Progress="{Binding TrainingProgress}"
                                ProgressColor="{StaticResource WtPrimary}"
                                BackgroundColor="Transparent"
                                HeightRequest="5"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center" />

                        </Grid>

                    </Grid>

                    <!-- Stats -->
                    <Border
                        Margin="0,18,0,0"
                        HorizontalOptions="Fill"
                        BackgroundColor="{StaticResource WtCard}"
                        Stroke="{StaticResource WtBorder}"
                        StrokeThickness="1"
                        Padding="10,12"
                        StrokeShape="RoundRectangle 22">

                        <Border.Shadow>
                            <Shadow
                                Brush="#10000000"
                                Offset="0,3"
                                Radius="7"
                                Opacity="0.12" />
                        </Border.Shadow>

                        <Grid
                            ColumnDefinitions="*,*,*,*"
                            HorizontalOptions="Fill">

                            <!-- Today -->
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="3"
                                HorizontalOptions="Center">

                                <Border
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="#EAF0FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">

                                    <Label
                                        Text="◎"
                                        TextColor="{StaticResource WtPrimary}"
                                        Style="{StaticResource StatIconLabelStyle}" />

                                </Border>

                                <Label
                                    Text="{Binding AnsweredToday}"
                                    Style="{StaticResource StatValueStyle}" />

                                <Label
                                    Text="Today"
                                    Style="{StaticResource StatCaptionStyle}" />

                            </VerticalStackLayout>

                            <!-- Correct -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3"
                                HorizontalOptions="Center">

                                <Border
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="#EAF9F0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">

                                    <Label
                                        Text="✓"
                                        TextColor="#16A45A"
                                        Style="{StaticResource StatIconLabelStyle}" />

                                </Border>

                                <Label
                                    Text="{Binding CorrectToday}"
                                    Style="{StaticResource StatValueStyle}" />

                                <Label
                                    Text="Correct"
                                    Style="{StaticResource StatCaptionStyle}" />

                            </VerticalStackLayout>

                            <!-- New -->
                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="3"
                                HorizontalOptions="Center">

                                <Border
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="#FFF3DF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">

                                    <Image
                                        Source="book_open.svg"
                                        WidthRequest="17"
                                        HeightRequest="17"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">

                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="#F59E0B" />
                                        </Image.Behaviors>

                                    </Image>

                                </Border>

                                <Label
                                    Text="{Binding NewConceptsToday}"
                                    Style="{StaticResource StatValueStyle}" />

                                <Label
                                    Text="New"
                                    Style="{StaticResource StatCaptionStyle}" />

                            </VerticalStackLayout>

                            <!-- Learned -->
                            <VerticalStackLayout
                                Grid.Column="3"
                                Spacing="3"
                                HorizontalOptions="Center">

                                <Border
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="#FFF0E8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">

                                    <Image
                                        Source="chart_column.svg"
                                        WidthRequest="17"
                                        HeightRequest="17"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">

                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="#F97316" />
                                        </Image.Behaviors>

                                    </Image>

                                </Border>

                                <Label
                                    Text="{Binding LearnedTotal}"
                                    Style="{StaticResource StatValueStyle}" />

                                <Label
                                    Text="Learned"
                                    Style="{StaticResource StatCaptionStyle}" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                    <!-- Empty state -->
                    <VerticalStackLayout
                        IsVisible="{Binding HasNoQuestion}"
                        Spacing="12"
                        Margin="0,36,0,0"
                        HorizontalOptions="Fill">

                        <Border
                            WidthRequest="56"
                            HeightRequest="56"
                            BackgroundColor="#EAF9F0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 28"
                            HorizontalOptions="Center">

                            <Label
                                Text="✓"
                                FontSize="27"
                                FontAttributes="Bold"
                                TextColor="#16A45A"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <Label
                            Text="{Binding TrainingCompleteText}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WtForeground}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="{Binding Message}"
                            FontSize="15"
                            TextColor="{StaticResource WtMutedText}"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                    <!-- Question state -->
                    <VerticalStackLayout
                        IsVisible="{Binding HasQuestion}"
                        Margin="0,26,0,0"
                        Spacing="0"
                        HorizontalOptions="Fill">

                        <!-- Word card -->
                        <Border
                            HorizontalOptions="Fill"
                            BackgroundColor="{StaticResource WtCard}"
                            Stroke="{StaticResource WtBorder}"
                            StrokeThickness="1"
                            Padding="18,16"
                            MinimumHeightRequest="148"
                            StrokeShape="RoundRectangle 22">

                            <Border.Shadow>
                                <Shadow
                                    Brush="#10000000"
                                    Offset="0,3"
                                    Radius="7"
                                    Opacity="0.12" />
                            </Border.Shadow>

                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="12">

                                <Border
                                    BackgroundColor="#EAF0FF"
                                    StrokeThickness="0"
                                    Padding="11,4"
                                    StrokeShape="RoundRectangle 13"
                                    HorizontalOptions="Center">

                                    <!-- Replace with Text="{Binding QuestionLevel}" when levels exist -->
                                    <Label
                                        Text="{Binding QuestionLevel}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource WtPrimary}" />

                                </Border>

                                <Label
                                    Text="{Binding QuestionText}"
                                    FontSize="32"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource WtForeground}"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    MaxLines="3"
                                    FontAutoScalingEnabled="False" />

                            </VerticalStackLayout>

                        </Border>

                        <!-- Answers -->
                        <VerticalStackLayout
                            Margin="0,18,0,0"
                            BindableLayout.ItemsSource="{Binding Options}"
                            Spacing="8"
                            HorizontalOptions="Fill">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>

                                    <Button
                                        HorizontalOptions="Fill"
                                        HeightRequest="52"
                                        CornerRadius="26"
                                        FontSize="16"
                                        FontAttributes="None"
                                        Text="{Binding DisplayText}"
                                        BackgroundColor="{Binding BackgroundColor}"
                                        TextColor="{Binding TextColor}"
                                        BorderColor="{Binding BorderColor}"
                                        BorderWidth="1"
                                        Command="{Binding BindingContext.AnswerCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                        <!-- I don't know -->
                        <HorizontalStackLayout
                            Margin="0,6,0,0"
                            HeightRequest="40"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="7">

                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowExplanationCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>

                            <Border
                                WidthRequest="17"
                                HeightRequest="17"
                                BackgroundColor="Transparent"
                                Stroke="{StaticResource WtMutedText}"
                                StrokeThickness="1.2"
                                StrokeShape="RoundRectangle 9">

                                <Label
                                    Text="?"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource WtMutedText}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>

                            <Label
                                Text="I don't know this word"
                                FontSize="14"
                                TextColor="{StaticResource WtMutedText}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
