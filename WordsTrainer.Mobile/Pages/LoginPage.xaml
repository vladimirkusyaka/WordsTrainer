<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="WordsTrainer.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FA"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary Source="/Resources/Styles/WordsTrainerTheme.xaml" />
    </ContentPage.Resources>

    <Grid Padding="24">

        <VerticalStackLayout
            MaximumWidthRequest="500"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="18">

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="WordsTrainer"
                    FontSize="38"
                    FontAttributes="Bold"
                    TextColor="{StaticResource WtForeground}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Train your vocabulary every day"
                    FontSize="17"
                    TextColor="{StaticResource WtMutedText}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border
                WidthRequest="380"
                BackgroundColor="{StaticResource WtCard}"
                Stroke="{StaticResource WtBorder}"
                StrokeThickness="1"
                Padding="22"
                StrokeShape="RoundRectangle 28">

                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Welcome back"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="{StaticResource WtForeground}" />

                        <Label
                            Text="Log in to continue"
                            FontSize="15"
                            TextColor="{StaticResource WtMutedText}" />
                    </VerticalStackLayout>

                    <Entry
                        Placeholder="Email"
                        Keyboard="Email"
                        Text="{Binding Email}"
                        HeightRequest="44"
                        FontSize="16"
                        BackgroundColor="#F9FAFB" />

                    <Entry
                        Placeholder="Password"
                        IsPassword="True"
                        Text="{Binding Password}"
                        HeightRequest="44"
                        FontSize="16"
                        BackgroundColor="#F9FAFB" />

                    <Button
                        Text="Login"
                        Style="{StaticResource WtPrimaryButton}"
                        Command="{Binding LoginCommand}" />

                    <Button
                        Text="Create account"
                        Style="{StaticResource WtSecondaryButton}"
                        Command="{Binding GoToRegisterCommand}" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="14"
                        TextColor="{StaticResource WtError}"
                        HorizontalTextAlignment="Center" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </Grid>

</ContentPage>